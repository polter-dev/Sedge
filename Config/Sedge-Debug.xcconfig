// Debug build settings for the Sedge app target.
// Pulls in the local, gitignored Secrets.xcconfig for any local-only settings.
// The "?" makes the include optional: a fresh clone without Secrets.xcconfig still builds.
#include? "../Secrets.xcconfig"

// The on-device model takes about 3 GB of memory, more than iOS gives an app by default.
CODE_SIGN_ENTITLEMENTS = Config/Sedge.entitlements
