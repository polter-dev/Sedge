# Copy this file to .env and fill in your Plaid Sandbox keys
# (https://dashboard.plaid.com/developers/keys). Never commit .env.
PLAID_CLIENT_ID=
PLAID_SECRET=
# Optional; when left out these default to sandbox, transactions and US.
PLAID_ENV=
PLAID_PRODUCTS=
PLAID_COUNTRY_CODES=
# Optional; only needed for OAuth banks.
PLAID_REDIRECT_URI=
